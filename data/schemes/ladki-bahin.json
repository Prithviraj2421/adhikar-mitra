{
  "level": "STATE",
  "target": "MEMBER",
  "state": "MH",
  "id": "ladki-bahin",
  "name": {
    "en": "Mukhyamantri Majhi Ladki Bahin Yojana",
    "hi": "मुख्यमंत्री मेरी लाड़ली बहन योजना",
    "mr": "मुख्यमंत्री माझी लाडकी बहीण योजना"
  },
  "summary": {
    "en": "Monthly support for eligible women of Maharashtra.",
    "hi": "महाराष्ट्र की पात्र महिलाओं को मासिक सहायता।",
    "mr": "महाराष्ट्रातील पात्र महिलांना मासिक मदत."
  },
  "department": "Women & Child Development Dept, Maharashtra",
  "category": "WOMEN",
  "benefit": {
    "type": "CASH_RECURRING",
    "estimatedAnnualINR": 18000,
    "description": {
      "en": "Monthly support, yearly total (estimated).",
      "hi": "मासिक सहायता, वार्षिक कुल (अनुमानित)।",
      "mr": "मासिक मदत, वार्षिक एकूण (अंदाजे)."
    }
  },
  "requiredDocuments": [
    "aadhaar",
    "income-certificate",
    "bank-account-aadhaar-seeded"
  ],
  "sourceUrls": [
    "https://ladakibahin.maharashtra.gov.in/"
  ],
  "eligibility": {
    "all": [
      {
        "id": "female",
        "field": "member.gender",
        "op": "eq",
        "value": "F",
        "label": {
          "en": "Applicant is a woman",
          "hi": "आवेदक महिला है",
          "mr": "अर्जदार महिला आहे"
        },
        "askQuestionId": "q_gender"
      },
      {
        "id": "age-range",
        "field": "member.age",
        "op": "between",
        "value": [
          21,
          65
        ],
        "label": {
          "en": "Age between 21 and 65",
          "hi": "आयु 21 से 65 के बीच",
          "mr": "वय 21 ते 65 दरम्यान"
        },
        "askQuestionId": "q_dob",
        "note": "VERIFY"
      },
      {
        "id": "income",
        "field": "household.annualIncomeINR",
        "op": "lte",
        "value": 250000,
        "label": {
          "en": "Family yearly income is within the limit",
          "hi": "परिवार की वार्षिक आय सीमा के भीतर है",
          "mr": "कुटुंबाचे वार्षिक उत्पन्न मर्यादेत आहे"
        },
        "askQuestionId": "q_income",
        "note": "VERIFY"
      },
      {
        "id": "resident",
        "field": "household.yearsResidentInMaharashtra",
        "op": "gte",
        "value": 15,
        "label": {
          "en": "Living in Maharashtra for at least 15 years",
          "hi": "महाराष्ट्र में कम से कम 15 वर्ष से निवास",
          "mr": "महाराष्ट्रात किमान 15 वर्षे वास्तव्य"
        },
        "askQuestionId": "q_resident",
        "note": "VERIFY"
      }
    ],
    "exclusions": [
      {
        "id": "taxpayer",
        "field": "member.isIncomeTaxPayer",
        "op": "eq",
        "value": true,
        "label": {
          "en": "Income tax payers are not eligible",
          "hi": "आयकर दाता पात्र नहीं हैं",
          "mr": "आयकर भरणारे पात्र नाहीत"
        },
        "askQuestionId": "q_tax"
      }
    ]
  },
  "application": {
    "modes": [
      {
        "type": "ONLINE",
        "url": "https://ladakibahin.maharashtra.gov.in/"
      },
      {
        "type": "OFFLINE",
        "officeTypes": [
          "ANGANWADI",
          "AAPLE_SARKAR_KENDRA"
        ]
      }
    ],
    "steps": [
      {
        "en": "Collect the documents listed for this scheme.",
        "hi": "इस योजना के लिए सूचीबद्ध दस्तावेज़ इकट्ठा करें।",
        "mr": "या योजनेसाठी सूचीतील कागदपत्रे गोळा करा."
      },
      {
        "en": "Apply on the official portal, or at the nearest help centre. It is free.",
        "hi": "आधिकारिक पोर्टल पर या नज़दीकी सहायता केंद्र पर आवेदन करें। यह निःशुल्क है।",
        "mr": "अधिकृत पोर्टलवर किंवा जवळच्या मदत केंद्रात अर्ज करा. हे मोफत आहे."
      },
      {
        "en": "Save your reference number and track it in Adhikar Mitra.",
        "hi": "अपना संदर्भ क्रमांक सहेजें और अधिकार मित्र में ट्रैक करें।",
        "mr": "तुमचा संदर्भ क्रमांक जतन करा आणि अधिकार मित्र मध्ये मागोवा घ्या."
      }
    ],
    "deadline": null
  },
  "verified": false,
  "lastVerified": null
}